# Base de datos (debe existir ya invemoto_schema_mysql8.sql aplicado)
# Si corres el backend directo con "npm run start:dev" (sin Docker), dejá DB_HOST=localhost.
# Si lo corres con "docker compose up", el docker-compose.yml de la raiz sobreescribe
# DB_HOST a "mysql" automaticamente (nombre del servicio en la red interna de Docker) -
# no hace falta que lo cambies vos a mano en ese caso.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invemoto

# Autenticacion
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Usado solo por "npm run seed" para crear la cuenta ADMIN inicial (equipo INVEMOTO)
SEED_ADMIN_EMAIL=equipo@invemoto.local
SEED_ADMIN_PASSWORD=cambia-esta-contrasena

PORT=3000
