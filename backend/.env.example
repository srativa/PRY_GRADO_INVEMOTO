# Base de datos (antes hay que haber cargado el script invemoto_schema_mysql8.sql)
# Si enciendes el backend sin Docker ("npm run start:dev"), deja DB_HOST=localhost.
# Si usas "docker compose up", Docker pone por su cuenta todos los datos de
# conexión a la base de datos, así que no hay que tocarlos.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invemoto

# Inicio de sesión
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Solo lo usa "npm run seed" para crear la cuenta de administrador del equipo.
SEED_ADMIN_EMAIL=equipo@invemoto.local
SEED_ADMIN_PASSWORD=cambia-esta-contrasena

PORT=3000
